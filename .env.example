# =============================================================================
# Al Harmain School System - Backend Environment Configuration (.env.example)
# Copy these variables into your own .env file with your actual credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL / Neon Cloud Database)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# DIRECT_URL is optional if your cloud DB requires a non-pooled connection for migrations
DIRECT_URL=

# -----------------------------------------------------------------------------
# 3. Authentication & JWT Tokens
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=1d

# -----------------------------------------------------------------------------
# 4. SaaS Platform Super Admin Seed Credentials (used by: npm run seed)
# -----------------------------------------------------------------------------
SUPER_ADMIN_NAME="Platform Super Admin"
SUPER_ADMIN_EMAIL=superadmin@edusaas.com
SUPER_ADMIN_PASSWORD=SuperAdmin123!
SUPER_ADMIN_PHONE=+923000000000

# -----------------------------------------------------------------------------
# 5. Cloudinary Storage (For Student Photos, Staff Documents & School Media)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# 6. Email / SMTP Notifications (For Invitations & Password Resets)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM="Al Harmain School System <no-reply@alharmainschool.edu.pk>"

# -----------------------------------------------------------------------------
# 7. Observe / Monitoring (Optional)
# -----------------------------------------------------------------------------
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET
